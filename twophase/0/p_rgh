FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    Reactor_Wall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    LiquidLevel
    {
        type            prghPressure;
        p               uniform 0;
        value           uniform 0;
    }

    Baffles
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    Impeller_1
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    Impeller_2
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    Impeller_3
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    Impeller_4
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    Shaft
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    Sparger
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

