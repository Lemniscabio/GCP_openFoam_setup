FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    Reactor_Wall
    {
        type            zeroGradient;
    }

    LiquidLevel
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }

    Baffles
    {
        type            zeroGradient;
    }

    Impeller_1
    {
        type            zeroGradient;
    }

    Impeller_2
    {
        type            zeroGradient;
    }

    Impeller_3
    {
        type            zeroGradient;
    }

    Impeller_4
    {
        type            zeroGradient;
    }

    Shaft
    {
        type            zeroGradient;
    }

    Sparger
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
