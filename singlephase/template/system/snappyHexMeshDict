FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    Reactor_Wall
    {
        type triSurfaceMesh;
        file "Reactor_Wall.stl";
        scale 1;
    }

    // LiquidLevel is now defined by the blockMesh 'top' face (z = maxZ = h_fill)
    // and renamed to LiquidLevel by createPatch. No STL needed.

    Baffles
    {
        type triSurfaceMesh;
        file "Baffles.stl";
        scale 1;
    }
    Impeller_1
    {
        type triSurfaceMesh;
        file "Impeller_1.stl";
        scale 1;
    }
    Impeller_2
    {
        type triSurfaceMesh;
        file "Impeller_2.stl";
        scale 1;
    }
    Impeller_3
    {
        type triSurfaceMesh;
        file "Impeller_3.stl";
        scale 1;
    }
    Impeller_4
    {
        type triSurfaceMesh;
        file "Impeller_4.stl";
        scale 1;
    }
    Shaft
    {
        type triSurfaceMesh;
        file "Shaft.stl";
        scale 1;
    }
    Rotor_Impeller1
    {
        type triSurfaceMesh;
        file "Rotor_Impeller1.stl";
        scale 0.001;
    }
    Rotor_Impeller2
    {
        type triSurfaceMesh;
        file "Rotor_Impeller2.stl";
        scale 0.001;
    }
    Rotor_Impeller3
    {
        type triSurfaceMesh;
        file "Rotor_Impeller3.stl";
        scale 0.001;
    }
    Rotor_Impeller4
    {
        type triSurfaceMesh;
        file "Rotor_Impeller4.stl";
        scale 0.001;
    }
}

castellatedMeshControls
{

    maxLocalCells 1000000;

    maxGlobalCells 3000000;

    minRefinementCells 80;

    nCellsBetweenLevels 2;

    maxLoadUnbalance 0.10;

    features
    (
    );
    
    refinementSurfaces
    {
       Reactor_Wall
        {
            level (1 1);   
            patchInfo
            {
                type wall;
            }
        }

        Baffles
        {
            level (1 1);  	
            patchInfo
            {
                type wall;
            }
        }
       
        // LiquidLevel removed — defined by createPatch renaming 'top'.

	Impeller_1
        {
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }


	Impeller_2
        {
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }


	Impeller_3
        {
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }


	Impeller_4
        {
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }


        // Rotor STL surfaces must keep cellZone/faceZone/cellZoneInside so
        // snappyHexMesh creates an internal zone (not a wall patch).
        // The MRF zones actually used are MRF_Rotor1..4, created by topoSet
        // from exact ROTOR_Z/ROTOR_R geometry (see system/topoSetDict).
        // These snappy-derived zones are superseded and sit unused — harmless.
        Rotor_Impeller1
        {
            level (1 1);
            cellZone Rotor_Impeller1;
            faceZone Rotor_Impeller1;
            cellZoneInside inside;
        }
        Rotor_Impeller2
        {
            level (1 1);
            cellZone Rotor_Impeller2;
            faceZone Rotor_Impeller2;
            cellZoneInside inside;
        }

        Rotor_Impeller3
        {
            level (1 1);
            cellZone Rotor_Impeller3;
            faceZone Rotor_Impeller3;
            cellZoneInside inside;
        }

        Rotor_Impeller4
        {
            level (1 1);
            cellZone Rotor_Impeller4;
            faceZone Rotor_Impeller4;
            cellZoneInside inside;
        }

	Shaft
        {
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }

    } 
    
      
    refinementRegions
    {
        // STL volumes used for local mesh refinement only (no zone creation).
        Rotor_Impeller1
        {
            mode inside;
            levels ((1 1));
        }

        Rotor_Impeller2
        {
            mode inside;
            levels ((1 1));
        }

        Rotor_Impeller3
        {
            mode inside;
            levels ((1 1));
        }

        Rotor_Impeller4
        {
            mode inside;
            levels ((1 1));
        }

    }     

    locationInMesh (0.5 0.5 1); // Inside point
    resolveFeatureAngle 45;
    allowFreeStandingZoneFaces true;
}

// Settings for the snapping.
snapControls
{

    nSmoothPatch 5;

    tolerance 2.0;

    nSolveIter 80;

    nRelaxIter 10;

    nFeatureSnapIter 15;

    implicitFeatureSnap true;

    explicitFeatureSnap true;

    multiRegionFeatureSnap true;
}

// Settings for the layer addition.
addLayersControls
{

    relativeSizes true;

    layers
    {
    }

    expansionRatio 1.0;

    finalLayerThickness 0.3;

    minThickness 0.25;

    nGrow 0;

    featureAngle 30;

    nRelaxIter 5;

    nSmoothSurfaceNormals 1;

    nSmoothNormals 3;

    nSmoothThickness 10;

    maxFaceThicknessRatio 0.5;

    maxThicknessToMedialRatio 0.3;

    minMedianAxisAngle 90;

    nBufferCellsNoExtrude 0;

    nLayerIter 50;

    nRelaxedIter 20;
}

meshQualityControls
{
    #include "meshQualityDict"

    relaxed
    {
        maxNonOrtho 75;
    }
}

writeFlags
(
);

mergeTolerance 1E-6;

// ************************************************************************* //

