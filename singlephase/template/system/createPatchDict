FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The blockMesh 'top' face (at z = maxZ = h_fill) IS the liquid level.
// No LiquidLevel.stl is needed; this dict renames 'top' → 'LiquidLevel'
// and sets it to symmetry type so it matches the 0/ field BCs.
//
// Run after snappyHexMesh, before decomposePar.

pointSync   false;
clearEmpty  true;

patches
(
    {
        name        LiquidLevel;
        patchInfo   { type symmetry; }
        constructFrom patches;
        patches     (top);
    }
);

