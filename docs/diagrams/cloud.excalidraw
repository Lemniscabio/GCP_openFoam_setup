    {
      "id": "UMhu2pSrMzWJSXN4oT_ym",
      "type": "text",
      "x": 2779.176827832678,
      "y": 1293.3047796015956,
      "width": 135.17116829431518,
      "height": 24.98433335806579,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
