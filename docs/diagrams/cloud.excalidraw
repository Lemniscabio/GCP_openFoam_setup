    {
      "id": "XxNC_I7jQmjVjC8wB8ir9",
      "type": "text",
      "x": 2961.9506071654687,
      "y": 829.3467186524197,
      "width": 268.5392641364162,
      "height": 224.8590002225921,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZO",
      "roundness": null,
      "seed": 172830399,
      "version": 1154,
      "versionNonce": 531462801,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781091748166,
      "link": null,
      "locked": false,
      "text": "Our previous approach of\nzipping in browser would\nhighly depend on client-side\nand is heavy on user-\nmachinery too. This\napproach helps cache\ndownloads across GCS, so\nany pull by any user of the\nsame download is faster.",
      "fontSize": 19.98746668645263,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our previous approach of zipping in browser would highly depend on client-side and is heavy on user-machinery too. This approach helps cache downloads across GCS, so any pull by any user of the same download is faster.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vSfz5FEUHIguqHzqDRKGa",
      "type": "text",
      "x": 2965.8879203275824,
      "y": 1129.7619107187857,
      "width": 268.5392641364162,
      "height": 224.8590002225921,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZS",
      "roundness": null,
      "seed": 2003401599,
      "version": 1448,
      "versionNonce": 1052741169,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781087951383,
      "link": null,
      "locked": false,
      "text": "This approach although\nsaving time at a larger level\n, but on first attempt it\ncan take 4-5 mins on a 1.5-\n2gb case. The exact time-\nbreakdown is to be\ncalculated, but the flow is\nGCS -> CloudRUN VM ->\nGCS",
      "fontSize": 19.98746668645263,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This approach although  saving time at a larger level , but on first attempt it can take 4-5 mins on a 1.5-2gb case. The exact time-breakdown is to be calculated, but the flow is GCS -> CloudRUN VM -> GCS",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "RX15DVXkdOJxvt1PxS17i",
      "type": "text",
      "x": 2658.939077265734,
      "y": 831.370681001569,
      "width": 268.5392641364162,
      "height": 224.8590002225921,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZV",
      "roundness": null,
      "seed": 1320140223,
      "version": 727,
      "versionNonce": 169647423,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781087285053,
      "link": null,
      "locked": false,
      "text": "There are block and NFS\nstorage options BUT this\naligns well with the\nworkflow. We dont need\nmultiple VMs accessing the\nsame file nor do we need\nextreme high IOPS speed\nduring VM-to-storage case\nloading.",
      "fontSize": 19.98746668645263,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are block and NFS storage options BUT this aligns well with the workflow. We dont need multiple VMs accessing the same file nor do we need extreme high IOPS speed during VM-to-storage case loading.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "TaGyha_IE2w1ILARW9EbH",
