FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      MRFProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Rotor_Impeller1
{
    cellZone    MRF_Rotor1;    // set by topoSet from ROTOR_Z[0], ROTOR_R
    active      yes;

    // Fixed patches (by default they 'move' with the MRF zone)
    nonRotatingPatches ();

    origin      (0 0 0);
    axis        (0 0 1);
    omega       100 [rpm];
}

